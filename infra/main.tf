terraform {
  required_version = ">= 1.17"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.8"
    }
  }
}

provider "aws" {
  region = "eu-west-3"
}

output "hello_url" {
  value = "${aws_apigatewayv2_api.http.api_endpoint}/hello"
}