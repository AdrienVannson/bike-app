{
  "name": "bike",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "build": "pnpm -r build",
    "aws:login": "aws sso login --sso-session cycling",
    "web:dev": "pnpm --filter @bike/web dev",
    "db:dev:sql": "env AWS_PROFILE=cycling-dev node db/scripts/sql.ts --env dev",
    "db:test:sql": "env AWS_PROFILE=cycling-test node db/scripts/sql.ts --env test",
    "db:prod:sql": "env AWS_PROFILE=cycling-prod node db/scripts/sql.ts --env prod",
    "db:dev:reset": "pnpm db:dev:sql db/schema.sql",
    "db:test:reset": "pnpm db:test:sql db/schema.sql",
    "db:dev:seed": "pnpm db:dev:sql db/seed.sql",
    "db:test:seed": "pnpm db:test:sql db/seed.sql",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check --formatter-enabled=false --error-on-warnings",
    "lint:fix": "biome check --formatter-enabled=false --write",
    "fmt": "pnpm fmt:ts && pnpm fmt:sql && pnpm fmt:tf",
    "fmt:ts": "biome format --write",
    "fmt:sql": "git ls-files -z '*.sql' | xargs -0 -n1 sql-formatter --fix -c .sql-formatter.json",
    "fmt:tf": "terraform -chdir=infra fmt -recursive",
    "fmt-check": "pnpm fmt-check:ts && pnpm fmt-check:sql && pnpm fmt-check:tf",
    "fmt-check:ts": "biome format",
    "fmt-check:sql": "git ls-files -z '*.sql' | xargs -0 -I{} sh -c 'sql-formatter -c .sql-formatter.json \"$1\" | diff -u \"$1\" -' _ {}",
    "fmt-check:tf": "terraform -chdir=infra fmt -recursive -check -diff",
    "tf:dev": "env AWS_PROFILE=cycling-dev terraform -chdir=infra/envs/dev",
    "tf:test": "env AWS_PROFILE=cycling-test terraform -chdir=infra/envs/test",
    "tf:prod": "env AWS_PROFILE=cycling-prod terraform -chdir=infra/envs/prod",
    "deploy:dev": "pnpm --filter @bike/api build && pnpm tf:dev apply",
    "tf:bootstrap:dev": "env AWS_PROFILE=cycling-dev TF_DATA_DIR=.terraform/dev TF_CLI_ARGS_init=-backend-config=path=state/dev.tfstate terraform -chdir=infra/bootstrap",
    "tf:bootstrap:test": "env AWS_PROFILE=cycling-test TF_DATA_DIR=.terraform/test TF_CLI_ARGS_init=-backend-config=path=state/test.tfstate terraform -chdir=infra/bootstrap",
    "tf:bootstrap:prod": "env AWS_PROFILE=cycling-prod TF_DATA_DIR=.terraform/prod TF_CLI_ARGS_init=-backend-config=path=state/prod.tfstate terraform -chdir=infra/bootstrap",
    "tf:validate": "for d in infra/envs/*/ infra/bootstrap; do echo \"== $d\" && TF_DATA_DIR=.terraform/validate terraform -chdir=$d init -backend=false -input=false -lockfile=readonly >/dev/null && TF_DATA_DIR=.terraform/validate terraform -chdir=$d validate || exit 1; done"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "sql-formatter": "15.9.0"
  }
}
